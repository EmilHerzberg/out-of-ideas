# =====================================================================
# out-of-ideas — environment variables
#
# Copy this file to `.env` and fill in your API keys.
# `.env` is gitignored — never commit it.
# =====================================================================

# --- Anthropic (Claude Opus 4.7 — top-tier generator) ---
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATOR_MODEL=claude-opus-4-7

# --- DeepSeek (V4 family — deepseek-v4-pro is current flagship) ---
# Sign up: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Generator model — used when DeepSeek is the chat provider for question generation.
# Options:
#   deepseek-v4-pro    — current flagship (Opus 4.7-class judgment, 1M context, 75% discount through 2026-05-31)
#   deepseek-v4-flash  — mid-tier; cheaper bulk option
#   deepseek-chat      — DEPRECATED 2026-07-24, alias for v4-flash non-thinking mode
#   deepseek-reasoner  — DEPRECATED 2026-07-24, alias for v4-flash thinking mode
DEEPSEEK_GENERATOR_MODEL=deepseek-v4-pro
# Quality-rating model — used by the quality stage. Default deepseek-chat
# (= v4-flash non-thinking) is fast + cheap; the archetype-aware rubric does
# the heavy lifting. Override to deepseek-v4-pro for stricter rating.
DEEPSEEK_QUALITY_MODEL=deepseek-chat

# --- OpenAI (GPT-5 — top-tier generator) ---
# Sign up: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_GENERATOR_MODEL=gpt-5

# --- Z.ai (ZhipuAI / GLM family — top model: glm-5.1, Apr 2026 flagship) ---
# Sign up: https://z.ai (intl) or https://open.bigmodel.cn (cn)
ZAI_API_KEY=
ZAI_GENERATOR_MODEL=glm-5.1
# ZAI_REGION: intl | cn (selects API endpoint)
ZAI_REGION=intl

# --- Moonshot AI (Kimi K2.6 — current shipping flagship, K3 expected Jun-Jul 2026) ---
# Sign up: https://platform.moonshot.ai (intl) or https://platform.moonshot.cn (cn)
MOONSHOT_API_KEY=
MOONSHOT_GENERATOR_MODEL=kimi-k2.6
# MOONSHOT_REGION: intl | cn (selects API endpoint)
MOONSHOT_REGION=intl

# --- BytePlus (international Volcano Engine ModelArk — Doubao Seed 2.0 Pro) ---
# Sign up: https://www.byteplus.com (intl) — for China use volcengine.com directly
# Pro is the frontier ByteDance model: comparable to GPT-5.2 / Opus 4.5 at
# $0.47/$2.37 per M tokens. NOT routed via OpenRouter, so set this key to
# unlock Pro-tier ByteDance in the rotation. When set, openrouter-doubao
# (which can only reach Seed 2.0 Lite) auto-shadows in favour of this slot.
BYTEPLUS_API_KEY=
# Options: doubao-seed-2-0-pro | doubao-seed-2-0-lite | doubao-seed-2-0-mini | doubao-seed-2-0-code
BYTEPLUS_GENERATOR_MODEL=doubao-seed-2-0-pro

# --- OpenRouter (single key, routes to 4 Chinese flagships in our rotation) ---
# Sign up: https://openrouter.ai
# Each model is a separate provider in the orchestrator's rotation — change
# the model id to swap to a different OpenRouter-hosted variant.
# Defaults below pin each rotation slot to the newest OpenRouter-available
# build of that vendor's frontier line as of 2026-05-03:
#   - Qwen 3.6 Max Preview (Alibaba)
#   - MiniMax M2.7 (no date pin → tracks latest M2.7 build)
#   - ERNIE 4.5 21B-A3B-Thinking (newest on OpenRouter — ERNIE 5.0 is not
#     yet routed; only via Baidu Qianfan)
#   - ByteDance Seed 2.0 Lite (newest on OpenRouter — Seed 2.0 Pro is not
#     yet routed; only via Volcano Engine / TokenMix)
OPENROUTER_API_KEY=
OPENROUTER_QWEN_MODEL=qwen/qwen3.6-max-preview
OPENROUTER_MINIMAX_MODEL=minimax/minimax-m2.7
# ERNIE: 5.0 (the actual frontier, 2.4T params, ranked 8th globally on
# LMArena) is ONLY available via Baidu Qianfan, which requires a Hong Kong
# phone number for international account verification — confirmed blocked
# 2026-05-03. OpenRouter routes only the 4.5 family. The 21B-A3B-thinking
# variant is the newest ERNIE on OpenRouter (Oct 2025).
OPENROUTER_ERNIE_MODEL=baidu/ernie-4.5-21b-a3b-thinking
OPENROUTER_DOUBAO_MODEL=bytedance-seed/seed-2.0-lite

# --- Perplexity (US — Sonar Pro fact verifier, web-grounded) ---
# Sign up: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# --- Voyage (US — voyage-3-large embeddings) ---
# Sign up: https://dash.voyageai.com
VOYAGE_API_KEY=

# --- DashScope / Alibaba Cloud (Qwen-Max generator + verifier, text-embedding-v4 embedder) ---
# Sign up: https://dashscope.console.aliyun.com (CN) or https://www.alibabacloud.com/product/modelstudio
DASHSCOPE_API_KEY=
DASHSCOPE_GENERATOR_MODEL=qwen-max
# DASHSCOPE_REGION: intl | cn (selects API endpoint)
DASHSCOPE_REGION=intl

# --- Google Cloud / Vertex AI ---
# Requires Application Default Credentials (run `gcloud auth application-default login`)
# OR provide a path to a Service Account JSON key (must have "Vertex AI User" role).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENERATOR_MODEL=gemini-3.1-pro-preview
GOOGLE_VERIFIER_MODEL=gemini-3-flash-preview
GOOGLE_EMBEDDER_MODEL=text-multilingual-embedding-002

# --- Vertex AI Model Garden partner models (use the SAME GOOGLE_CLOUD_PROJECT + service account) ---
# Each must be Enabled in the Cloud Console > Vertex AI > Model Garden before first use.
# No separate API keys needed — auth is via the same service-account JSON.
VERTEX_MISTRAL_GENERATOR_MODEL=mistral-large-2411
VERTEX_AI21_GENERATOR_MODEL=jamba-1.5-large
VERTEX_GROK_GENERATOR_MODEL=grok-4-1-fast-non-reasoning

# --- Provider selection (overridden by --provider CLI flag) ---
# PROVIDER_GENERATOR: anthropic | deepseek | google | openai | dashscope | vertex-mistral | vertex-ai21 | vertex-grok | zai | moonshot | byteplus | openrouter-qwen | openrouter-minimax | openrouter-ernie | openrouter-doubao
PROVIDER_GENERATOR=google
# PROVIDER_VERIFIER: perplexity | dashscope | google (Gemini with web search)
PROVIDER_VERIFIER=google
# PROVIDER_EMBEDDER: voyage | dashscope | google (text-embedding-004)
PROVIDER_EMBEDDER=google

# --- Optional ---
LOG_LEVEL=info
